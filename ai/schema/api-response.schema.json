{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "whatif/api-response.schema.json",
  "title": "AI API 응답 (공통 응답 형태)",
  "description": "공통 규칙: 성공은 isSuccess true + code {도메인}{HTTP}_{번호}, 데이터 없으면 result null. 에러는 isSuccess false + result null, message는 화면 문구. 검증 에러는 필드별 코드 첫 번째 하나만, 형식 오류는 COMMON400_1.",
  "$defs": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "isSuccess",
        "code",
        "message",
        "result"
      ],
      "properties": {
        "isSuccess": {
          "const": false
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z]+[45]\\d\\d_\\d+$"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "type": "null"
        }
      }
    },
    "chatSuccess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "isSuccess",
        "code",
        "message",
        "result"
      ],
      "properties": {
        "isSuccess": {
          "const": true
        },
        "code": {
          "const": "AI200_1"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "type",
                "answerText",
                "summaryText",
                "newCondition",
                "result",
                "v1Result",
                "versionCard",
                "usedAssumptions"
              ],
              "properties": {
                "type": {
                  "const": "change"
                },
                "answerText": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "summaryText": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "newCondition": {
                  "$ref": "condition.schema.json"
                },
                "result": {
                  "type": "object"
                },
                "v1Result": {
                  "type": "object",
                  "required": [
                    "finalAsset",
                    "goalShortfall"
                  ]
                },
                "versionCard": {
                  "type": "object",
                  "required": [
                    "no",
                    "title",
                    "baseVersionNo"
                  ]
                },
                "usedAssumptions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            {
              "type": "object",
              "required": [
                "type",
                "answerText",
                "highlightMonths"
              ],
              "properties": {
                "type": {
                  "const": "explain"
                },
                "answerText": {
                  "type": "string"
                },
                "highlightMonths": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
                  }
                }
              }
            },
            {
              "type": "object",
              "required": [
                "type",
                "answerText",
                "options"
              ],
              "properties": {
                "type": {
                  "const": "clarify"
                },
                "answerText": {
                  "type": "string"
                },
                "options": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 4,
                  "items": {
                    "type": "object",
                    "required": [
                      "label",
                      "question"
                    ]
                  }
                }
              }
            },
            {
              "type": "object",
              "required": [
                "type",
                "answerText",
                "productQuery"
              ],
              "properties": {
                "type": {
                  "const": "finance"
                },
                "answerText": {
                  "type": "string"
                },
                "productQuery": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "enum": [
                        "deposit",
                        "saving"
                      ]
                    },
                    "termMonths": {
                      "type": "integer"
                    },
                    "amountMax": {
                      "type": "integer"
                    },
                    "monthlyAmount": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "sort": {
                      "enum": [
                        "maxRate",
                        "baseRate",
                        "term"
                      ]
                    },
                    "limit": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 10
                    }
                  }
                }
              }
            },
            {
              "type": "object",
              "required": [
                "type",
                "answerText",
                "examples"
              ],
              "properties": {
                "type": {
                  "const": "refuse"
                },
                "answerText": {
                  "type": "string"
                },
                "examples": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "summarySuccess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "isSuccess",
        "code",
        "message",
        "result"
      ],
      "properties": {
        "isSuccess": {
          "const": true
        },
        "code": {
          "const": "AI200_2"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "type": "object",
          "required": [
            "text",
            "usedAssumptions"
          ],
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 80
            },
            "usedAssumptions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "scenarioNameSuccess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "isSuccess",
        "code",
        "message",
        "result"
      ],
      "properties": {
        "isSuccess": {
          "const": true
        },
        "code": {
          "const": "AI200_3"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "type": "object",
          "required": [
            "suggestedName"
          ],
          "properties": {
            "suggestedName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 30
            }
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/chatSuccess"
    },
    {
      "$ref": "#/$defs/summarySuccess"
    },
    {
      "$ref": "#/$defs/scenarioNameSuccess"
    },
    {
      "$ref": "#/$defs/error"
    }
  ]
}
